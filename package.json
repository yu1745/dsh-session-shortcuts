{
  "name": "@yu1745/dsh-session-shortcuts",
  "version": "1.0.0",
  "description": "Cycle through visible DSH Web sessions with keyboard shortcuts.",
  "type": "module",
  "engines": { "node": ">=22", "dsh": "^0.2.2-rc.3" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-shortcuts", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-api-workspace-controller"]
    }
  },
  "scripts": { "test": "node --test" }
}
